# Run docker compose from the repository root. Use an absolute path if you
# launch Compose from another directory. This is a directory, not a hostname.
B4F_HOST_WORKSPACE=${PWD}/.workspace

# Open http://localhost:8080. Only the local machine can access this port.
B4F_HTTP_PORT=8080

# Linux Docker Engine socket:
B4F_DOCKER_SOCKET=/var/run/docker.sock
# Docker Desktop on macOS: replace the line above with:
# B4F_DOCKER_SOCKET=${HOME}/.docker/run/docker.sock
